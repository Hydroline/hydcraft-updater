{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Allow HydCraft Updater windows to use the native window controls.",
	"windows": ["main", "auth", "version", "client-details"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:window:allow-close",
		"core:window:allow-minimize",
		"core:window:allow-start-dragging",
		"core:webview:deny-internal-toggle-devtools",
		"core:webview:deny-print",
		"dialog:default"
	]
}
